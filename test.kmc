		"redirectBehavior" : "NORMAL",
		"headers" : "",
		"payload" : "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:ns=\"http://zhstregisterjp.ksta.zh.ch/xmlns/zhquest/2\" xmlns:ns1=\"http://zhstregisterjp.ksta.zh.ch/xmlns/zhstregisterjp/sslPersonDetailType/2\" xmlns:ns2=\"http://zhstregisterjp.ksta.zh.ch/xmlns/zhstregisterjp/kStARegisterNrWithoutCheckDigitType/1\" xmlns:ns3=\"http://zhstregisterjp.ksta.zh.ch/xmlns/zhstregisterjp/sslPersonType/1\" xmlns:ns4=\"http://zhstregisterjp.ksta.zh.ch/xmlns/zhstregisterjp/sslJuristischePersonType/1\" xmlns:ns5=\"http://www.ech.ch/xmlns/eCH-0097/2\" xmlns:ns6=\"http://zhstregisterjp.ksta.zh.ch/xmlns/zhstregisterjp/sslNatuerlichePersonType/1\" xmlns:ns7=\"http://zhstregisterjp.ksta.zh.ch/xmlns/common/vnNumber13Type/1\" xmlns:ns8=\"http://zhstregisterjp.ksta.zh.ch/xmlns/zhstregisterjp/addressType/2\" xmlns:ns9=\"http://zhstregisterjp.ksta.zh.ch/xmlns/zhstregisterjp/sslKontaktType/1\">\n   <soapenv:Header/>\n   <soapenv:Body>\n      <ns:registerSSLRequestType>\n         <ticketId>?</ticketId>\n         <sslPersonDetailType>\n            <!--Zero or more repetitions:-->\n            <ns1:registerNrWithoutCheckDigit>\n               <ns2:kStARegisterNr>?</ns2:kStARegisterNr>\n               <ns2:kStARegisterNrType>?</ns2:kStARegisterNrType>\n            </ns1:registerNrWithoutCheckDigit>\n            <ns1:sslPerson>\n               <!--You have a CHOICE of the next 2 items at this level-->\n               <ns3:sslJuristsichePerson>\n                  <!--Optional:-->\n                  <ns4:firmenname>?</ns4:firmenname>\n                  <!--Optional:-->\n                  <ns4:telefonNummer>?</ns4:telefonNummer>\n                  <!--Optional:-->\n                  <ns4:faxNummer>?</ns4:faxNummer>\n                  <!--Optional:-->\n                  <ns4:dateOfFoundation>?</ns4:dateOfFoundation>\n                  <!--Optional:-->\n                  <ns4:liquidationBeschlussDatum>?</ns4:liquidationBeschlussDatum>\n                  <!--Optional:-->\n                  <ns4:liquidationErledigungDatum>?</ns4:liquidationErledigungDatum>\n                  <!--Optional:-->\n                  <ns4:hregLoeschungZustimmungDatum>?</ns4:hregLoeschungZustimmungDatum>\n                  <!--Optional:-->\n                  <ns4:rechtsForm>?</ns4:rechtsForm>\n                  <!--Optional:-->\n                  <ns4:grundkapital>?</ns4:grundkapital>\n                  <!--Optional:-->\n                  <ns4:municipality>?</ns4:municipality>\n                  <!--Zero or more repetitions:-->\n                  <ns4:registerNrWithoutCheckDigitFusion>\n                     <ns2:kStARegisterNr>?</ns2:kStARegisterNr>\n                     <ns2:kStARegisterNrType>?</ns2:kStARegisterNrType>\n                  </ns4:registerNrWithoutCheckDigitFusion>\n                  <!--Optional:-->\n                  <ns4:branche>?</ns4:branche>\n                  <!--Optional:-->\n                  <ns4:vertreterNummer>?</ns4:vertreterNummer>\n                  <!--Optional:-->\n                  <ns4:vertretungsArt>?</ns4:vertretungsArt>\n                  <!--Optional:-->\n                  <ns4:nogaCode>?</ns4:nogaCode>\n                  <!--Optional:-->\n                  <ns4:oe>?</ns4:oe>\n                  <!--Optional:-->\n                  <ns4:uId>\n                     <ns5:uidOrganisationIdCategorie>?</ns5:uidOrganisationIdCategorie>\n                     <ns5:uidOrganisationId>?</ns5:uidOrganisationId>\n                  </ns4:uId>\n                  <!--Optional:-->\n                  <ns4:steuerGruppe>?</ns4:steuerGruppe>\n               </ns3:sslJuristsichePerson>\n               <!--Optional:-->\n               <ns3:sslNatuerlichePerson>\n                  <!--Zero or more repetitions:-->\n                  <ns6:versicherungsNummer>\n                     <!--Optional:-->\n                     <ns7:vn>?</ns7:vn>\n                  </ns6:versicherungsNummer>\n                  <!--Optional:-->\n                  <ns6:anrede>?</ns6:anrede>\n                  <!--Optional:-->\n                  <ns6:titel>?</ns6:titel>\n                  <!--Optional:-->\n                  <ns6:name>?</ns6:name>\n                  <!--Optional:-->\n                  <ns6:vorname>?</ns6:vorname>\n                  <!--Optional:-->\n                  <ns6:geburtsdatum>?</ns6:geburtsdatum>\n                  <!--Optional:-->\n                  <ns6:geschlecht>?</ns6:geschlecht>\n                  <!--Optional:-->\n                  <ns6:telefonNummerGeschaeft>?</ns6:telefonNummerGeschaeft>\n                  <!--Optional:-->\n                  <ns6:telefonNummerPrivat>?</ns6:telefonNummerPrivat>\n                  <!--Optional:-->\n                  <ns6:faxNummer>?</ns6:faxNummer>\n                  <!--Optional:-->\n                  <ns6:municipality>?</ns6:municipality>\n               </ns3:sslNatuerlichePerson>\n            </ns1:sslPerson>\n            <ns1:sslAdresse>\n               <!--Optional:-->\n               <ns8:adresseTyp>?</ns8:adresseTyp>\n               <!--Optional:-->\n               <ns8:addressAddOn1>?</ns8:addressAddOn1>\n               <!--Optional:-->\n               <ns8:addressAddOn2>?</ns8:addressAddOn2>\n               <!--Optional:-->\n               <ns8:street>?</ns8:street>\n               <!--Optional:-->\n               <ns8:houseNumber>?</ns8:houseNumber>\n               <!--Optional:-->\n               <ns8:dwellingNumber>?</ns8:dwellingNumber>\n               <!--Optional:-->\n               <ns8:postOfficeBoxText>?</ns8:postOfficeBoxText>\n               <!--Optional:-->\n               <ns8:swissZipCode>?</ns8:swissZipCode>\n               <!--Optional:-->\n               <ns8:swissZipCodeAddOn>?</ns8:swissZipCodeAddOn>\n               <!--Optional:-->\n               <ns8:swissZipCodeId>?</ns8:swissZipCodeId>\n               <!--Optional:-->\n               <ns8:foreignZipCode>?</ns8:foreignZipCode>\n               <!--Optional:-->\n               <ns8:locality>?</ns8:locality>\n               <!--Optional:-->\n               <ns8:town>?</ns8:town>\n               <!--Optional:-->\n               <ns8:country>?</ns8:country>\n               <!--Optional:-->\n               <ns8:stadtkreis>?</ns8:stadtkreis>\n               <!--Optional:-->\n               <ns8:adresseVonDat>?</ns8:adresseVonDat>\n               <!--Optional:-->\n               <ns8:zustellStoppDat>?</ns8:zustellStoppDat>\n               <!--Optional:-->\n               <ns8:zustellStoppGrund>?</ns8:zustellStoppGrund>\n            </ns1:sslAdresse>\n            <ns1:sslKontakt>\n               <!--Optional:-->\n               <ns9:anrede>?</ns9:anrede>\n               <!--Optional:-->\n               <ns9:titel>?</ns9:titel>\n               <!--Optional:-->\n               <ns9:name>?</ns9:name>\n               <!--Optional:-->\n               <ns9:vorname>?</ns9:vorname>\n               <!--Optional:-->\n               <ns9:namenZusatz>?</ns9:namenZusatz>\n               <!--Optional:-->\n               <ns9:abteilung>?</ns9:abteilung>\n               <!--Optional:-->\n               <ns9:emailAdresse>?</ns9:emailAdresse>\n               <!--Optional:-->\n               <ns9:telefonNummerGeschaeft>?</ns9:telefonNummerGeschaeft>\n               <!--Optional:-->\n               <ns9:telefonNummerMobil>?</ns9:telefonNummerMobil>\n               <!--Optional:-->\n               <ns9:faxNummer>?</ns9:faxNummer>\n            </ns1:sslKontakt>\n            <ns1:status>?</ns1:status>\n            <!--Optional:-->\n            <ns1:konkursEroeffnungDatum>?</ns1:konkursEroeffnungDatum>\n            <!--Optional:-->\n            <ns1:konkursSchuldenrufFristDatum>?</ns1:konkursSchuldenrufFristDatum>\n            <!--Optional:-->\n            <ns1:konkursErledigungDatum>?</ns1:konkursErledigungDatum>\n            <!--Optional:-->\n            <ns1:sslSteuergemeinde>?</ns1:sslSteuergemeinde>\n            <!--Zero or more repetitions:-->\n            <ns1:arbeitgeber