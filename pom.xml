<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>net.mmo.utils.monitoring_kiss</groupId>
	<artifactId>monitoring_kiss</artifactId>
	<name>MonitoringKISS</name>
	<version>1.0-SNAPSHOT</version>
	<packaging>jar</packaging>

	<properties>
		<maven.compiler.source>11</maven.compiler.source>
		<maven.compiler.target>11</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

		<!-- some local settings: -->
		<user.home>U:/</user.home>
		<user.repo>${user.home}.m2/m2repository/</user.repo>
		<vaadin.version>14.4.2</vaadin.version>
		<wdm.version>4.2.2</wdm.version>	<!-- wdm = WebDriver Manager -->
		<!-- should be passed in via an environment variable or some -D option -->
		<webdriver.maven.repo>${user.repo}</webdriver.maven.repo>
	</properties>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>2.3.2.RELEASE</version>
	</parent>

	<repositories>
		<!-- The order of definitions matters. Explicitly defining central here to make sure it has the highest priority. -->

		<!-- Main Maven repository -->
		<repository>
			<id>central</id>
			<url>https://repo.maven.apache.org/maven2</url>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</repository>
		<!-- Repository used by many Vaadin add-ons: -->
		<repository>
			<id>Vaadin Directory</id>
			<url>https://maven.vaadin.com/vaadin-addons</url>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</repository>
	</repositories>

	<pluginRepositories>
		<!-- Main Maven repository -->
		<pluginRepository>
			<id>central</id>
			<url>https://repo.maven.apache.org/maven2</url>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</pluginRepository>
	</pluginRepositories>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.vaadin</groupId>
				<artifactId>vaadin-bom</artifactId>
				<version>${vaadin.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- Vaadin stuff: -->
		<dependency>
			<groupId>com.vaadin</groupId>
			<!-- Replace artifactId with vaadin-core to use only free components -->
			<artifactId>vaadin</artifactId>
			<exclusions>
				<!-- Webjars are only needed when running in Vaadin 13 compatibility mode -->
				<exclusion>
					<groupId>com.vaadin.webjar</groupId>
					<artifactId>*</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.webjars.bowergithub.insites</groupId>
					<artifactId>*</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.webjars.bowergithub.polymer</groupId>
					<artifactId>*</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.webjars.bowergithub.polymerelements</groupId>
					<artifactId>*</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.webjars.bowergithub.vaadin</groupId>
					<artifactId>*</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.webjars.bowergithub.webcomponents</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>com.vaadin</groupId>
			<artifactId>vaadin-spring-boot-starter</artifactId>
			<exclusions>
				<!-- Excluding so that webjars are not included. -->
				<exclusion>
					<groupId>com.vaadin</groupId>
					<artifactId>vaadin-core</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<optional>true</optional>
		</dependency>
		<!-- non-declared dependency of the above -->
		<dependency>
			<groupId>javax.websocket</groupId>
			<artifactId>javax.websocket-api</artifactId>
		</dependency>
		<!-- 
		<dependency>
			<groupId>com.vaadin</groupId>
			<artifactId>vaadin-testbench</artifactId>
			<scope>test</scope>
		</dependency>
		 -->

		<!-- SpringBoot security (for login screen) -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-config</artifactId>
		</dependency>
		<!-- Spring Security references HttpServletRequest and -Response. 
			When building for a barebones servlet container (Tomcat, Jetty, etc) 
			instead of a full fledged Java EE application server (WildFly, TomEE, GlassFish, 
			Liberty, etc), one thus needs to add the javax.servlet API to the compile time 
			dependencies. It's not needed to include it in the build, it's already provided 
			by the target servlet container:
		-->
		<dependency>
			<groupId>javax.servlet</groupId>
			<artifactId>javax.servlet-api</artifactId>
			<scope>provided</scope>
		</dependency>
		<!-- If you happen to actually deploy to a Java EE 7+ application server 
			like WildFly, use the below dependency instead. It covers the entire Java 
			EE API, including javax.servlet 
		->
		<dependency>
			<groupId>javax</groupId>
			<artifactId>javaee-api</artifactId>
			<version>7.0</version>
			<scope>provided</scope>
		</dependency>
		<!- -->
		
		<!-- JUnit 5 = JUnit Platform + JUnit Jupiter + JUnit Vintage -->

		<!-- required for IT tests with SpringBoot: -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
			<exclusions>
				<exclusion>
					<groupId>org.junit.vintage</groupId>
					<artifactId>junit-vintage-engine</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!--database dependencies -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!-- Spring's JPA apparently also requires spring-aop (but doesn't seem 
			to declare it ||-( It got <some error>... Caused by: java.lang.NoClassDefFoundError: 
			org.springframework.data.jpa.repository.JpaRepository ... but after having 
			declared it ONCE, everything worked. Even after removing it again?!? And 
			even after I cleared the local m2repo. Very Odd! 
		<dependency>
			<groupId>org.springframework</groupId> 
			<artifactId>spring-aop</artifactId>
		</dependency>
		-->

		<!-- Using in-memory H2 Database -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- required when using Vaadin BeanValidators: -->
		<!-- Hibernate validator - Bean validation API Implementation -->
		<dependency>
			<groupId>org.hibernate</groupId>
			<artifactId>hibernate-validator</artifactId>
			<version>6.0.21.Final</version>
		</dependency>
		<!-- the following are obviously referenced by hibernate validator - why are these not in its pom? -->
		<dependency>
			<groupId>javax.el</groupId>
			<artifactId>javax.el-api</artifactId>
			<version>3.0.0</version>
		</dependency>
		<dependency>
			<groupId>org.glassfish.web</groupId>
			<artifactId>javax.el</artifactId>
			<version>2.2.4</version>
		</dependency>

		<!-- webdriver-manager to allow running the Integration Tests on Chrome
			This is used from the JUnit test class and downloads the correct version 
			of the Chrome web driver, if it is missing. 
			The webdriver itself is then used by the integration tests. 
		-->
		<dependency>
			<groupId>io.github.bonigarcia</groupId>
			<artifactId>webdrivermanager</artifactId>
			<version>${wdm.version}</version>
			<scope>test</scope>
		</dependency>

		<!-- Lombok - generates setters and getters and allows for other goodies like @Slf4j, toString(), etc. -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<!-- fitting version is already defined in spring-boot-dependencies -->
			<type>jar</type>
			<scope>provided</scope>
		</dependency>

		<!-- for AspectJ: -->
		<!-- Instrumentations are enabled as a javaagent that run on the JVM. Springs org.springframework:spring-instrument.jar 
			ships the InstrumentationSavingAgent which saves the instrumentation.
			To run AspectJ load-time weaving in a spring environment it is necessary to have these two instrumentations: 
		-->
		<!-- AspectJ version is mentioned in springboot-starter ->
		<dependency>
			<groupId>org.aspectj</groupId>
			<artifactId>aspectjtools</artifactId> 
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-instrument</artifactId>
		</dependency>
		<dependency>
			<groupId>org.aspectj</groupId>
			<artifactId>aspectjweaver</artifactId>
		</dependency>
		<!- -->
		<!-- for ArchUnit-tests (executed during UTs): -->
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>0.14.1</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<defaultGoal>spring-boot:run</defaultGoal>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- Clean build and startup time for Vaadin apps sometimes may exceed the default Spring Boot's 30sec timeout. -->
					<wait>500</wait>
					<maxAttempts>240</maxAttempts>
					<!-- the following is for the co-existence of Lombok and AspectJ: -> 
					<agent>
						<agentElement>
							${user.repo}org/springframework/spring-instrument/${spring.version}/spring-instrument-${spring.version}.jar
						</agentElement>
						<agentElement>
							${user.repo}org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar
						</agentElement>
					</agent>
					<systemPropertyVariables>
						<aj.weaving.loadersToSkip>
							org.springframework.context.support.ContextTypeMatchClassLoader$ContextOverridingClassLoader,
							org.springframework.data.jpa.repository.config.InspectionClassLoader
						</aj.weaving.loadersToSkip>
					</systemPropertyVariables>
					<!- -->
				</configuration>
			</plugin>

			<!-- Take care of synchronizing java dependencies and imports in package.json 
				and main.js files. It also creates webpack.config.js if not exists yet. -->
			<plugin>
				<groupId>com.vaadin</groupId>
				<artifactId>vaadin-maven-plugin</artifactId>
				<version>${vaadin.version}</version>
				<executions>
					<execution>
						<goals>
							<goal>prepare-frontend</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

		</plugins>
	</build>

	<profiles>
		<profile>
			<!-- Production mode is activated using -Pproduction -->
			<id>production</id>
			<properties>
				<vaadin.productionMode>true</vaadin.productionMode>
			</properties>

			<dependencies>
				<dependency>
					<groupId>com.vaadin</groupId>
					<artifactId>flow-server-production-mode</artifactId>
				</dependency>
			</dependencies>

			<build>
				<plugins>
					<plugin>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-maven-plugin</artifactId>
						<configuration>
							<jvmArguments>-Dvaadin.productionMode</jvmArguments>
						</configuration>
					</plugin>
					<plugin>
						<groupId>com.vaadin</groupId>
						<artifactId>vaadin-maven-plugin</artifactId>
						<version>${vaadin.version}</version>
						<executions>
							<execution>
								<goals>
									<goal>build-frontend</goal>
								</goals>
								<phase>compile</phase>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<profile>
			<id>unit-tests</id> <!-- will only be executed if "-Punit-tests" is passed on the mvn cmd-line -->
			<build>
				<plugins>
					<plugin> <!-- this plugin runs the Unit Tests (Integrations Tests are excluded) -->
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<version>3.0.0-M8</version>
						<executions>
							<execution>
								<goals>
									<goal>test</goal>
								</goals>
							</execution>
						</executions>
						<configuration>
							<excludes>
								<exclude>**/*IT.java</exclude> <!-- Excludes integration tests when unit tests are run. -->
							</excludes>
							<!-- Found here: https://www.robingander.de/blog/2019/aspectj-spring-boot-lombok.html
								See https://github.com/subes/invesdwin-instrument instead, this can load the spring-instrument into the running JVM
								There arose some problems in a real application where the spring instrumentation and aspectjweaver did weave 
								classes in a circular loop. Happily the aspectjweaver has an undocumented system property (-Daj.weaving.loadersToSkip=...) 
								to exclude springs classloaders, to overcome this problem ->
							<argLine>
								-javaagent:${user.home}/.m2/repository/org/springframework/spring-instrument/${spring.version}/spring-instrument-${spring.version}.jar
								-javaagent:${user.home}/.m2/repository/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar
								-Daj.weaving.loadersToSkip=org.springframework.context.support.ContextTypeMatchClassLoader$ContextOverridingClassLoader,org.springframework.data.jpa.repository.config.InspectionClassLoader
							</argLine>
							<!- -->
						</configuration>
					</plugin>

					<!-- JaCoCo: Code Coverage (runs as part of unit tests)
					     Note: When using the maven-surefire-plugin or maven-failsafe-plugin you must not use a 
					     forkCount of 0 or set the forkMode to never as this would prevent the execution of the 
					     tests with the javaagent set and no coverage would be recorded. 
					-->
					<plugin>
						<groupId>org.jacoco</groupId>
						<artifactId>jacoco-maven-plugin</artifactId>
						<version>0.8.5</version>
						<executions>
							<!-- Prepares the property pointing to the JaCoCo runtime agent which 
								is passed as VM argument when the Maven Surefire plugin is executed. -->
							<execution>
								<id>pre-unit-test</id>
								<goals>
									<goal>prepare-agent</goal>
								</goals>
								<configuration>
									<!-- Sets the name of the property containing the settings for JaCoCo runtime agent. -->
									<propertyName>surefireArgLine</propertyName>
								</configuration>
							</execution>
							<!-- Ensures that the code coverage report for unit tests is created after unit tests have been run. -->
							<execution>
								<id>post-unit-test</id>
								<phase>test</phase>
								<goals>
									<goal>report</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<profile>
			<id>integration-tests</id>	<!-- will only be executed if "-Pintegration-tests" is passed on the mvn cmd-line -->
			<build>
				<plugins>
					<!-- To run the integration test the webserver must be started before and stopped afterwards. -->
					<plugin>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-maven-plugin</artifactId>
						<executions>
							<execution> <!-- in phase "pre-integration-test" run the plugin's goal "start": -->
								<id>start-spring-boot</id>
								<phase>pre-integration-test</phase>
								<goals>
									<goal>start</goal>
								</goals>
							</execution>
							<execution> <!-- in phase "post-integration-test" run the plugin's goal "stop": -->
								<id>stop-spring-boot</id>
								<phase>post-integration-test</phase>
								<goals>
									<goal>stop</goal>
								</goals>
							</execution>
						</executions>
					</plugin>

					<!-- This plugin runs the integration tests:
					     Note: The name of the test classes needs to end in '...IT' for the test runner to pick it up as an 
					     integration test. Otherwise they will be picked up as unit-test and the test will most likely fail 
					-->
					<plugin> <!-- This plugin runs the integration tests (i.e. tests named *IT) after the server is started -->
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-failsafe-plugin</artifactId>
						<executions>
							<execution>
								<goals>
									<goal>integration-test</goal>
									<goal>verify</goal>
								</goals>
							</execution>
						</executions>
						<configuration>
							<trimStackTrace>false</trimStackTrace>
							<enableAssertions>true</enableAssertions>
							<!--  ->
							<argLine>
								-javaagent:${user.home}/.m2/repository/org/springframework/spring-instrument/${spring.version}/spring-instrument-${spring.version}.jar
								-javaagent:${user.home}/.m2/repository/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar
								-Daj.weaving.loadersToSkip=org.springframework.context.support.ContextTypeMatchClassLoader$ContextOverridingClassLoader,org.springframework.data.jpa.repository.config.InspectionClassLoader
							</argLine>
							<!- -->
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

	</profiles>
</project>