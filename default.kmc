al:-->\n                  <ns4:liquidationErledigungDatum>?</ns4:liquidationErledigungDatum>\n                  <!--Optional:-->\n                  <ns4:hregLoeschungZustimmungDatum>?</ns4:hregLoeschungZustimmungDatum>\n                  <!--Optional:-->\n                  <ns4:rechtsForm>?</ns4:rechtsForm>\n                  <!--Optional:-->\n                  <ns4:grundkapital>?</ns4:grundkapital>\n                  <!--Optional:-->\n                  <ns4:municipality>?</ns4:municipality>\n                  <!--Zero or more repetitions:-->\n                  <ns4:registerNrWithoutCheckDigitFusion>\n                     <ns2:kStARegisterNr>?</ns2:kStARegisterNr>\n                     <ns2:kStARegisterNrType>?</ns2:kStARegisterNrType>\n                  </ns4:registerNrWithoutCheckDigitFusion>\n                  <!--Optional:-->\n                  <ns4:branche>?</ns4:branche>\n                  <!--Optional:-->\n                  <ns4:vertreterNummer>?</ns4:vertreterNummer>\n                  <!--Optional:-->\n                  <ns4:vertretungsArt>?</ns4:vertretungsArt>\n                  <!--Optional:-->\n                  <ns4:nogaCode>?</ns4:nogaCode>\n                  <!--Optional:-->\n                  <ns4:oe>?</ns4:oe>\n                  <!--Optional:-->\n                  <ns4:uId>\n                     <ns5:uidOrganisationIdCategorie>?</ns5:uidOrganisationIdCategorie>\n                     <ns5:uidOrganisationId>?</ns5:uidOrganisationId>\n                  </ns4:uId>\n                  <!--Optional:-->\n                  <ns4:steuerGruppe>?</ns4:steuerGruppe>\n               </ns3:sslJuristsichePerson>\n               <!--Optional:-->\n               <ns3:sslNatuerlichePerson>\n                  <!--Zero or more repetitions:-->\n                  <ns6:versicherungsNummer>\n                     <!--Optional:-->\n                     <ns7:vn>?</ns7:vn>\n                  </ns6:versicherungsNummer>\n                  <!--Optional:-->\n                  <ns6: